# systemd unit for OTReader (LLRP race timing middleware).
#
# Expected layout (see README "Running as a service"):
#   /opt/otreader              application checkout (read-only to the service)
#   /opt/otreader/.venv        Python virtual environment
#   /opt/otreader/config.yaml  configuration (application.data_directory: ./data)
#   /opt/otreader/data         database, logs, pinned reader SSH key (owned by otreader)
#   /var/run/reader            reader IP address, written by another process (read-only here)
#
# Install:
#   sudo cp deploy/otreader.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now otreader
#   journalctl -u otreader -f

[Unit]
Description=OTReader LLRP race timing middleware
Documentation=file:///opt/otreader/README.md
# Not network-online.target: on a Pi cabled straight to the reader that target can hold
# boot for minutes while the link has no carrier. OTReader waits for /var/run/reader and
# retries the reader connection itself.
After=network.target time-sync.target
# Never stop restarting an unattended race-day service.
StartLimitIntervalSec=0

[Service]
Type=simple
User=otreader
Group=otreader
WorkingDirectory=/opt/otreader
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

# The reader clock is set from this host's clock once at start-up, and only if the host
# clock is synchronised. Give NTP/GPS up to 60 s after boot to sync; then start anyway
# (timing must not depend on a time source being available). Always exits 0.
ExecStartPre=/opt/otreader/.venv/bin/python -m app.clockwait --timeout 60
ExecStart=/opt/otreader/.venv/bin/python -m app.main --config /opt/otreader/config.yaml
TimeoutStartSec=120

Restart=always
RestartSec=5
# Graceful stop: stop the reader, finalise open finish-line passes, commit events,
# write the inventory snapshot, close the database. SIGINT and SIGTERM both do this.
KillSignal=SIGINT
TimeoutStopSec=45

# --- Sandboxing ---------------------------------------------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/otreader/data
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# No capabilities needed (API port > 1024). For a port below 1024 add:
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=
UMask=0027
# Deliberately NOT set: ProtectClock=yes. Its syscall filter blocks adjtimex(), which
# OTReader uses read-only to check the host clock is synchronised before setting the
# reader clock; with it the safeguard would silently stop working.

[Install]
WantedBy=multi-user.target
